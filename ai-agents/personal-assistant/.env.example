# Copy this file to .env and fill in the values. Never share or commit .env.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Send /start to your bot once; it replies with your id. Put it here:
TELEGRAM_OWNER_ID=
# Optional — only for the actions you want:
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
